# Public site URL (no trailing slash)
# Local: http://localhost:3000 · Production: https://knowyourcompanytype.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional base path for GitHub Pages (e.g. /knowyourcompanytype)
NEXT_PUBLIC_BASE_PATH=

# When site is on GitHub Pages, point submit form to your API host (Vercel, etc.)
# Example: https://api.knowyourcompanytype.com
NEXT_PUBLIC_SUBMIT_API_URL=

# Comma-separated extra CORS origins for the API (e.g. https://nuthanm.github.io)
API_CORS_ORIGINS=

# PostgreSQL (Neon recommended) — optional in dev; submissions stored when set
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Gmail / SMTP (App Password: https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="Know Your Company Type <noreply@knowyourcompanytype.com>"
MAIL_TO=admin@knowyourcompanytype.com

# Optional: public catalog URL (GitHub Pages) — used for email "Add to queue" redirects
NEXT_PUBLIC_CATALOG_URL=https://nuthanm.github.io/KnowYourCompanyType

# Math CAPTCHA secret — any random string (used for HMAC signing of challenge tokens)
# Production: auto-generated by scripts/setup-vercel-env.ps1
CAPTCHA_SECRET=replace_with_a_random_secret_string

# -----------------------------------------------------------------------------
# Vercel production (API host) — run: .\scripts\setup-vercel-env.ps1 -SmtpPass "..."
# Required on Vercel:
#   NEXT_PUBLIC_SITE_URL, NEXT_PUBLIC_CATALOG_URL, API_CORS_ORIGINS, CAPTCHA_SECRET,
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, MAIL_FROM, MAIL_TO
# Optional on Vercel (needed for pending queue persistence):
#   DATABASE_URL and/or UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
#   ADMIN_API_KEY
# GitHub Pages also needs repo variable SUBMIT_API_URL=https://knowyourcompanytype.vercel.app
# -----------------------------------------------------------------------------

# Google AdSense — https://www.google.com/adsense/
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Optional: Upstash Redis for shared rate limiting on serverless
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin key for reviewing submissions via API (optional)
ADMIN_API_KEY=replace_with_secure_random_key
